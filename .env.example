# Copy to .env and adjust. Loaded automatically (repo root or CWD) by
# Python entrypoints (via src/dotenv.py, stdlib-only) and by run_*.sh /
# runpod_web.sh. Real exported environment variables always win over .env.
# Custom file location: set ASR_ENV_FILE=/path/to/.env (or DOTENV_PATH).

# --- Managed directories (src/paths.py; explicit CLI flags win) ---
# ASR_OUTPUT_DIR=outputs/buzzasr-neyshekar-lora
# ASR_RESULTS_DIR=results
# ASR_MERGED_DIR=models/buzzasr-persian-fine-tuned
# Colon-separated extra roots allowed under server sandboxing:
# ASR_ALLOWED_OUTPUT_ROOTS=/workspace:/runpod-volume:/mnt

# --- Hugging Face caches (raw downloads + datasets.map temps) ---
# Default: biggest writable disk (see src/cache.py) — NOT /workspace, which
# is a small persistent volume that fills with OSError 28. Checkpoints stay
# on /workspace; caches are ephemeral and re-downloadable.
# Explicit values always win over auto-pick — except HF_HOME, which pod
# images set to /workspace/... by default and is overridden with a warning.
# Set ASR_HONOR_HF_HOME=1 only if you deliberately pointed HF_HOME somewhere.
# ASR_HF_CACHE_DIR=/tmp/hf_cache
# HF_DATASETS_CACHE=/tmp/hf_cache/datasets
# HF_HOME=/tmp/hf_cache
# ASR_HONOR_HF_HOME=1
# Prepared Arrow datasets (85G+; big disk by default, NOT /workspace):
# ASR_PREP_CACHE_DIR=/tmp/prep_cache
# (Point it at /workspace/stt-outputs/prep_cache only if that volume has room
# and you want reuse across pod restarts.)

# --- Hugging Face auth (scripts/upload_to_hf.py, datasets, transformers) ---
# HF_TOKEN=hf_...
# HUGGING_FACE_HUB_TOKEN=hf_...

# --- Web cockpit (server/app.py, runpod_web.sh) ---
# PORT=7860
# HOST=0.0.0.0
# ASR_COCKPIT_TOKEN=secret-token-here
# ASR_HALT_GRACE_SECONDS=900

# --- Local demo (scripts/demo_local.py, run_local_demo.sh) ---
# PORT=7860
# DEMO_FAIL_AT_STEP=0
