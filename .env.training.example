# ============================================================================
# HF-backed Persian ASR training
#
# Put this file on the GPU pod at /workspace/stt/.env (chmod 600).
# On the local machine you only need RUNPOD_API_KEY in .env (see the bottom).
#
# Replace every REPLACE_WITH_* value before starting.
# ============================================================================

# --- Hugging Face auth ------------------------------------------------------
# Needs write access to the prep dataset repo, the run mirror repo, and the
# final merged-model repo.
HF_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN

# --- 1. Prepared-feature cache (HF dataset repo) ---------------------------
# The paired train/ cache is ~168 GB. Free HF private storage is 100 GB, so
# this repo must be PUBLIC unless your plan has enough private storage.
# Create it in the HF UI as a public Dataset repo before the first prep run,
# or let the prep script create it (public via ASR_PREP_HF_PUBLIC=1).
ASR_PREP_HF_REPO=ameerhossein/liquidwhisper-neyshekar-prep
ASR_PREP_HF_PUBLIC=1

# Only relevant for a private repo. Leave commented for the public free-tier
# setup; set it if your private storage limit is different:
# ASR_PREP_HF_PRIVATE_LIMIT_GB=100

# Prep work happens on the big container disk (ephemeral), not the 200 GB
# /workspace volume. The durable copy lives in HF and is downloaded on demand.
ASR_PREP_CACHE_DIR=/root/prep_cache
ASR_HF_CACHE_DIR=/root/hf_cache
HF_DATASETS_CACHE=/root/hf_cache/datasets

# --- 2. Durable run mirror (HF model repo) ---------------------------------
# Checkpoints, adapter snapshots, best_adapter, reports, and merged/ are
# mirrored here. The repo is created private by default.
ASR_HF_RUN_REPO=ameerhossein/liquidwhisper-neyshekar

# --- Persistent paths on /workspace (survive a pod restart) ----------------
ASR_OUTPUT_DIR=/workspace/stt-outputs/buzzasr-neyshekar-lora
ASR_RESULTS_DIR=/workspace/stt-outputs/results
ASR_RUNS_DIR=/workspace/stt-outputs/results/runs
ASR_MERGED_DIR=/workspace/stt-outputs/buzzasr-persian-merged

# --- Web cockpit ------------------------------------------------------------
PORT=7860
HOST=0.0.0.0
# Optional API gate for Start/Stop/Merge. The current web UI does NOT prompt
# for it, so leave it unset if you use the cockpit buttons. Set it only if you
# drive the API with curl and send X-Auth-Token:
# ASR_COCKPIT_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_24

# --- Local machine only -----------------------------------------------------
# Do not put this in the pod's .env; the pod does not need RunPod credentials.
# RUNPOD_API_KEY=rpa_REPLACE_WITH_YOUR_KEY
